{
  "name": "frontend",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "run:ios": "expo run:ios",
    "run:android": "expo run:android",
    "prebuild:ios": "npx expo prebuild -p ios --clean",
    "build:ios-sim": "eas build --platform ios --profile development --local",
    "build:android": "eas build --platform android --profile development --local",
    "dev:ios": "npm run build:ios-sim && expo start --dev-client",
    "dev:android": "npm run build:android && expo start --dev-client"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/bottom-tabs": "^7.4.6",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/stack": "^7.4.7",
    "@reduxjs/toolkit": "^2.8.2",
    "expo": "~53.0.22",
    "expo-audio": "~0.4.9",
    "expo-blur": "~14.1.5",
    "expo-dev-client": "~5.2.4",
    "expo-file-system": "^18.1.11",
    "expo-font": "^13.3.2",
    "expo-linear-gradient": "^14.1.5",
    "expo-modules-core": "^2.5.0",
    "expo-status-bar": "~2.2.3",
    "lottie-react-native": "7.2.2",
    "nativewind": "^4.1.23",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-redux": "^9.2.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "~5.8.3"
  },
  "private": true
}
