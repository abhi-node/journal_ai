{
  "name": "frontend",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "run:ios": "expo run:ios",
    "run:android": "expo run:android",
    "prebuild:ios": "npx expo prebuild -p ios --clean",
    "build:ios-sim": "eas build --platform ios --profile development --local",
    "build:android": "eas build --platform android --profile development --local",
    "dev:ios": "npm run build:ios-sim && expo start --dev-client",
    "dev:android": "npm run build:android && expo start --dev-client"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.8.2",
    "expo": "~53.0.22",
    "expo-dev-client": "~5.2.4",
    "expo-status-bar": "~2.2.3",
    "nativewind": "^4.1.23",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "^5.6.1",
    "react-redux": "^9.2.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "~5.8.3"
  },
  "private": true
}
